<Window x:Class="SalonApp.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Salon Appointment System" Height="600" Width="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigacija -->
        <StackPanel Grid.Column="0" Background="#2D3142">
            <TextBlock Text="Salon App" FontSize="18" FontWeight="Bold" 
                       Foreground="White" Margin="15,20,15,30"/>
            <Button Content="Klijenti" Click="Clients_Click" 
                    Margin="10,5" Padding="10,8" HorizontalContentAlignment="Left"/>
            <Button Content="Usluge" Click="Services_Click" 
                    Margin="10,5" Padding="10,8" HorizontalContentAlignment="Left"/>
            <Button Content="Zaposleni" Click="Staff_Click" 
                    Margin="10,5" Padding="10,8" HorizontalContentAlignment="Left"/>
            <Button Content="Termini" Click="Appointments_Click" 
                    Margin="10,5" Padding="10,8" HorizontalContentAlignment="Left"/>
        </StackPanel>

        <!-- Sadrzaj -->
        <ContentControl Grid.Column="1" x:Name="MainContent" Margin="20"/>
    </Grid>
</Window>